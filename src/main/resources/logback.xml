<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%level] %msg%n</pattern>
    </encoder>
  </appender>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%level] %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="ORCH_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="com.leftrr.agentscheduling.logging.ExactLevelFilter">
      <level>ERROR</level>
      <onMatch>DENY</onMatch>
      <onMismatch>ACCEPT</onMismatch>
    </filter>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%level] %msg%n</pattern>
    </encoder>
  </appender>
  <appender name="ORCH_STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="com.leftrr.agentscheduling.logging.ExactLevelFilter">
      <level>ERROR</level>
      <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>
    <target>System.err</target>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%level] %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="com.leftrr.agentscheduling.app.CardActionHandler" level="error" additivity="false">
    <appender-ref ref="STDERR"/>
  </logger>
  <logger name="com.leftrr.agentscheduling.app.Notifications" level="error" additivity="false">
    <appender-ref ref="STDERR"/>
  </logger>

  <logger name="com.leftrr.agentscheduling.app.BotMessageOrchestrator" additivity="false">
    <appender-ref ref="ORCH_STDOUT"/>
    <appender-ref ref="ORCH_STDERR"/>
  </logger>
  <logger name="com.leftrr.agentscheduling.app.DocumentCommentScheduler" additivity="false">
    <appender-ref ref="ORCH_STDOUT"/>
    <appender-ref ref="ORCH_STDERR"/>
  </logger>
  <logger name="com.leftrr.agentscheduling.Main" additivity="false">
    <appender-ref ref="ORCH_STDOUT"/>
    <appender-ref ref="ORCH_STDERR"/>
  </logger>

  <!--
    MCP SDK（io.modelcontextprotocol，SLF4J）日志静默。agent_scheduling server 现以长驻
    HTTP 形态跑在主进程内（历史形态为 stdio 子进程，当时 stdout 是 JSON-RPC 通道，
    任何 SDK 日志都会毒化协议流导致 claude/codex 握手失败）。改 HTTP 后 stdout
    不再承载协议，保留静默只为压掉每会话连接的 INFO 噪音；如需排查 MCP 握手
    问题，临时把 level 调到 debug。
  -->
  <logger name="io.modelcontextprotocol" level="off"/>

  <root level="info">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
